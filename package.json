{
  "name": "xfleet",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "migrate": "bun src/db/migrate.ts",
    "hash-password": "bun scripts/hash-password.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write \"{src,scripts}/**/*.{ts,tsx,css}\" \"styles/**/*.css\" \"*.ts\"",
    "format:check": "prettier --check \"{src,scripts}/**/*.{ts,tsx,css}\" \"styles/**/*.css\" \"*.ts\"",
    "knip": "knip",
    "reuse": "uvx reuse lint",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip && bun run reuse && bun run test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "bcryptjs": "^3.0.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.14.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0"
  }
}
